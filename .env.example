# Local application (Render supplies PORT automatically)
APP_PORT=3000
APP_NAME=la-hermandad-backend
API_PREFIX=api

# Local Docker PostgreSQL
DATABASE_NAME=la_hermandad
DATABASE_USER=postgres
DATABASE_PASSWORD=change-me
DATABASE_URL="postgresql://postgres:change-me@localhost:5433/la_hermandad?schema=public"

# Set a long random secret before running the application
JWT_SECRET=
